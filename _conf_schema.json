{
  "admin_qqs": {
    "description": "管理员QQ号列表",
    "type": "list",
    "hint": "输入管理员的QQ号，支持多个",
    "default": []
  },
  "ai_config": {
    "description": "AI 模型配置",
    "type": "object",
    "items": {
      "base_url": {
        "description": "API Base URL",
        "type": "string",
        "hint": "例如：https://api.deepseek.com/v1"
      },
      "api_key": {
        "description": "API Key",
        "type": "string",
        "hint": "输入你的 API Key",
        "obvious_hint": true
      },
      "api_format": {
        "description": "API 格式",
        "type": "string",
        "options": ["chat_completions", "responses"],
        "labels": ["Chat Completions（/chat/completions）", "Responses（/responses）"],
        "default": "chat_completions",
        "hint": "选择模型服务使用的 OpenAI 兼容接口格式。已有配置默认继续使用 Chat Completions"
      },
      "send_temperature": {
        "description": "发送 temperature 参数",
        "type": "bool",
        "default": true,
        "hint": "默认开启以保持旧配置行为。部分推理模型（如 o 系列，或推理强度非 none 的新模型）不接受 temperature，可按服务要求关闭；关闭后两种 API 格式的请求都不包含该参数。"
      },
      "model": {
        "description": "模型名称",
        "type": "string",
        "default": "deepseek-chat",
        "hint": "例如：deepseek-chat、gpt-3.5-turbo"
      }
    }
  },
  "rate_limit": {
    "description": "频率限制配置",
    "type": "object",
    "items": {
      "window_minutes": {
        "description": "限制时间窗口（分钟）",
        "type": "int",
        "default": 10
      },
      "max_requests_per_window": {
        "description": "窗口内最大请求次数（基于QQ号全局限制）",
        "type": "int",
        "default": 3
      },
      "daily_max": {
        "description": "每日最大请求次数（基于QQ号全局限制）",
        "type": "int",
        "default": 20
      }
    }
  },
  "preset_games": {
    "description": "预设游戏列表",
    "type": "list",
    "hint": "输入游戏名称，支持多个（每行一个）",
    "default": ["原神", "星露谷物语", "艾尔登法环", "塞尔达传说：王国之泪", "博德之门3"]
  },
  "search_config": {
    "description": "联网搜索配置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "是否启用联网搜索（旧开关）",
        "type": "bool",
        "default": true,
        "hint": "兼容旧配置。false 会强制关闭搜索（off），优先于 mode；不要与 mode=off 同时误用。"
      },
      "mode": {
        "description": "搜索模式",
        "type": "string",
        "options": ["auto", "astrbot", "api", "web", "off"],
        "labels": ["自动（AstrBot → API → 网页）", "仅 AstrBot", "仅搜索 API", "仅网页搜索", "关闭"],
        "default": "auto",
        "hint": "auto 按已验证的 AstrBot 搜索、已配置 API、网页搜索顺序尝试；手动模式默认不降级。"
      },
      "fallback_enabled": {
        "description": "手动模式允许降级",
        "type": "bool",
        "default": false,
        "hint": "仅对 astrbot/api/web 手动模式生效。开启后按 auto 顺序继续尝试后续后端；auto 始终按顺序降级。"
      },
      "api_provider": {
        "description": "搜索 API 提供商",
        "type": "string",
        "options": ["tavily"],
        "labels": ["Tavily"],
        "default": "tavily",
        "hint": "当前仅验证 Tavily。未配置有效 Key 时不会调用 API。"
      },
      "api_key": {
        "description": "搜索 API Key",
        "type": "string",
        "hint": "Tavily API Key（tvly-...）。留空时跳过 API 后端，不发起请求。",
        "obvious_hint": true
      },
      "api_base_url": {
        "description": "搜索 API Base URL",
        "type": "string",
        "default": "https://api.tavily.com",
        "hint": "Tavily 官方地址。固定使用 basic 搜索（1 credit/次），不自动重试。"
      },
      "result_count": {
        "description": "采用搜索结果条数",
        "type": "int",
        "default": 3,
        "hint": "统一结果与每个网页搜索源采用的条数（1-10）"
      },
      "summarize_enabled": {
        "description": "是否启用搜索汇总",
        "type": "bool",
        "default": true,
        "hint": "开启后通过 AI 对搜索结果进行分析整理，关闭则直接使用原始搜索结果"
      },
      "summarize_max_chars": {
        "description": "搜索汇文字数限制",
        "type": "int",
        "default": 150,
        "hint": "AI 生成或回退的搜索汇总最大字数（50-500），实际进入生成 Prompt 前强制截断"
      },
      "timeout_ms": {
        "description": "搜索总时间预算（毫秒）",
        "type": "int",
        "default": 8000,
        "hint": "整个搜索流程的总预算，所有后端共享，不会各自累加超时"
      }
    }
  },
  "whitelist_groups": {
    "description": "白名单群聊列表",
    "type": "list",
    "hint": "留空表示所有群聊均可使用。填写群号后，仅这些群聊可使用小作文功能",
    "default": []
  },
  "whitelist_privates": {
    "description": "白名单私聊列表",
    "type": "list",
    "hint": "留空表示所有私聊均可使用。填写QQ号后，仅这些私聊可使用小作文功能",
    "default": []
  },
  "show_generation_stats": {
    "description": "生成后发送统计信息",
    "type": "bool",
    "hint": "开启后每次生成小作文后会额外发送一条生成信息（模型、耗时、Token、搜索汇总等）",
    "default": true
  }
}
